# ────────────────────────────────────────────────────────────────
# Beyond Shape — monorepo ignore rules
# Repo holds the design corpus + the new implementation (browser monolith).
# ────────────────────────────────────────────────────────────────

# Old 2018 reference clones — already versioned at github.com/KODHAGe/*
# (kept on disk for reference only; NOT tracked in this repo)
/shape-constructor/
/shape-interpreter/
/shape-renders/
/shape-decoder/
/shape-mapper/
/shape-consumer/

# Node / Vite / build
node_modules/
dist/
build/
.vite/
*.tsbuildinfo
coverage/

# Env & secrets (keep .env.example)
.env
.env.*
!.env.example

# Generated model artifacts — regenerated by scripts/train_generator.py
# (models.json manifest IS committed; the .onnx binaries are not)
public/models/*.onnx

# onnxruntime-web assets — copied from node_modules by scripts/copy-ort-wasm.mjs
public/ort-wasm/*.wasm
public/ort-wasm/*.mjs

# Cloudflare / Playwright
.wrangler/
test-results/
playwright-report/

# Python toolchain (LR-9) — pinned in requirements.txt
.venv/
__pycache__/
*.pyc

# Terraform (infra as code, infra/terraform/) — state and provider dirs are local
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/terraform.tfvars
infra/terraform/terraform.tfvars.json
*.tfplan

# Cloudflare credentials for local infra commands — source ./.cf.env, never commit
.cf.env

# Logs
*.log
npm-debug.log*

# OS / editor junk
.DS_Store
Thumbs.db
.idea/
.vscode/
# Original thesis PDF — persisted elsewhere; text is committed as ORIGINAL-2019.md
Beyond shape, 24.1.2019.pdf
